<!-- Adaptive Navbar Component -->
<nav class="navbar" id="navbar">
    <!-- Main Navigation Container -->
    <div class="navbar__container" id="navbarContainer">
        <!-- Logo Section -->
        <div class="navbar__header">
    <div class="navbar__logo">
        <div class="navbar__logo-icon" role="button" tabindex="0" aria-label="Toggle sidebar" id="navbarLogoToggle">
            <!-- Base Claude-like symbol -->
            <svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="4" y="5" width="16" height="14" rx="3"></rect>
                <line x1="9" y1="5" x2="9" y2="19"></line>
            </svg>
            <!-- Hover arrows; shown depending on collapsed state via CSS -->
            <svg class="arrow arrow--left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="9" y1="5" x2="9" y2="19"></line>
                <polyline points="15 16 11 12 15 8"></polyline>
            </svg>
            <svg class="arrow arrow--right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="15" y1="5" x2="15" y2="19"></line>
                <polyline points="9 8 13 12 9 16"></polyline>
            </svg>
        </div>
        <div class="navbar__logo-text">
            <span class="navbar__brand-logo" aria-label="Marke.tel">
                <svg width="56" height="59" viewBox="0 0 56 59" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M44 59L44 12L20.8421 12.0001L0 12.0001L-2.08064e-06 59L44 59Z" fill="#DE4E28"/>
                    <path d="M11 11L11 4.31609e-07L1 11L11 11Z" fill="#398D8D"/>
                    <path d="M45 37H56L45 58L45 37Z" fill="#398D8D"/>
                    <path d="M24.6119 16H39V55H28.6941L30.4926 25.7659H28.4366L26.6195 55H16.3805L15.2787 31.5916L13.2228 31.6L14.3059 55H4V29.6341C4 27.4358 4.78075 25.5967 6.34226 24.1171C7.94837 22.5951 9.91141 21.8341 12.2314 21.8341H16.5813C16.9828 20.1008 17.942 18.7057 19.4589 17.6488C20.9758 16.5496 22.6934 16 24.6119 16Z" fill="#E9E3D3"/>
                </svg>
            </span>
        </div>
    </div>
</div>

        <!-- Navigation Menu -->
        <nav class="navbar__menu" role="navigation">
            <a href="../today/" class="navbar__link {{isActive activePage 'today'}}" data-nav="today">
                <span class="navbar__link-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                        <circle cx="12" cy="16" r="1" fill="currentColor"></circle>
                    </svg>
                </span>
                <span class="navbar__link-text">Today</span>
                <span class="navbar__link-badge" id="navbar-today-badge" style="display:none;">0</span>
                <span class="navbar__link-tooltip">Today</span>
            </a>

            <a href="../dashboard/" class="navbar__link {{isActive activePage 'dashboard'}}" data-nav="dashboard">
                <span class="navbar__link-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                </span>
                <span class="navbar__link-text">Dashboard</span>
                <span class="navbar__link-tooltip">Dashboard</span>
            </a>

            <a href="../team/" class="navbar__link {{isActive activePage 'team'}}" data-nav="team">
                <span class="navbar__link-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </span>
                <span class="navbar__link-text">Team</span>
                <span class="navbar__link-tooltip">Team</span>
            </a>

            <a href="../schedules/" class="navbar__link {{isActive activePage 'schedules'}}" data-nav="schedules">
                <span class="navbar__link-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </span>
                <span class="navbar__link-text">Shift Schedules</span>
                <span class="navbar__link-tooltip">Shift Schedules</span>
            </a>

            <a href="../onboarding/" class="navbar__link {{isActive activePage 'onboarding'}}" data-nav="onboarding">
                <span class="navbar__link-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <line x1="19" y1="8" x2="19" y2="14"></line>
                        <line x1="22" y1="11" x2="16" y2="11"></line>
                    </svg>
                </span>
                <span class="navbar__link-text">Onboarding</span>
                <span class="navbar__link-tooltip">Onboarding</span>
            </a>

            <a href="../billing/" class="navbar__link {{isActive activePage 'billing'}}" data-nav="billing">
                <span class="navbar__link-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                        <line x1="2" y1="10" x2="22" y2="10"></line>
                    </svg>
                </span>
                <span class="navbar__link-text">Billing</span>
                <span class="navbar__link-tooltip">Billing</span>
            </a>
        </nav>

        <!-- User Section -->
        <div class="navbar__user">
            <div class="navbar__user-toggle" tabindex="0" aria-label="Toggle navbar">
                <div class="navbar__user-avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <div class="navbar__user-info">
                    <span class="navbar__user-name">{{userName}}</span>
                    <span class="navbar__user-role">{{userRole}}</span>
                </div>
            </div>
        </div>
    </div>
</nav>
