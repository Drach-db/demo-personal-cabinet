<!-- Header Component - CLEANED VERSION -->
<div class="header" id="header">
    <div class="header__container">
        <!-- Content section (левая часть) -->
        <div class="header__content">
            <h1 class="header__title">
                {{#if pageIcon}}
                    <svg class="header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        {{{pageIcon}}}
                    </svg>
                {{/if}}
                <span>{{pageTitle}}</span>
            </h1>
            
            <!-- Breadcrumbs (optional) -->
            {{#if breadcrumbs}}
            <nav class="header__breadcrumbs" aria-label="Breadcrumb">
                {{#each breadcrumbs}}
                    {{#if @last}}
                        <span class="breadcrumb-current" aria-current="page">{{this.label}}</span>
                    {{else}}
                        <a href="{{this.url}}" class="breadcrumb-link">{{this.label}}</a>
                        <span class="breadcrumb-separator" aria-hidden="true">/</span>
                    {{/if}}
                {{/each}}
            </nav>
            {{/if}}
        </div>
        
        <!-- Mobile burger menu (только для мобильных) -->
        <button class="header__mobile-toggle" id="headerMobileToggle" aria-label="Menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
    </div>
</div>