<!-- Navbar Component Partial -->
<nav class="navbar" id="navbar">
    <!-- Header -->
    <div class="navbar-header">
        <div class="logo-container">
            <div class="logo-icon">
                <span>M</span>
                <div class="initial-glow" id="initialGlow" style="display: none;"></div>
            </div>
            <div class="logo-text-wrapper">
                <span class="logo-text">MarkeTel</span>
                <span class="logo-subtitle">NEXT-GEN BPO</span>
            </div>
        </div>
        
        <button type="button" class="collapse-btn" id="collapseBtn" title="Toggle navigation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>
    </div>

    <!-- Navigation Menu -->
    <div class="nav-menu">
        <div class="nav-item">
            <a href="../today/" class="nav-link {{isActive activePage 'today'}}" data-nav-id="today">
                <div class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                        <circle cx="12" cy="16" r="1" fill="currentColor"></circle>
                    </svg>
                </div>
                <span class="nav-text">Today</span>
                <div class="nav-tooltip">Today</div>
            </a>
        </div>

        <div class="nav-item">
            <a href="../dashboard/" class="nav-link {{isActive activePage 'dashboard'}}" data-nav-id="dashboard">
                <div class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                </div>
                <span class="nav-text">Dashboard</span>
                <div class="nav-tooltip">Dashboard</div>
            </a>
        </div>

        <div class="nav-item">
            <a href="../team/" class="nav-link {{isActive activePage 'team'}}" data-nav-id="team">
                {{#if (isActive activePage 'team')}}
                <div class="nav-indicator"></div>
                {{/if}}
                <div class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <span class="nav-text">Team</span>
                <div class="nav-tooltip">Team</div>
            </a>
        </div>

        <div class="nav-item">
            <a href="../schedules/" class="nav-link {{isActive activePage 'schedules'}}" data-nav-id="schedules">
                <div class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <span class="nav-text">Shift Schedules</span>
                <div class="nav-tooltip">Shift Schedules</div>
            </a>
        </div>

        <div class="nav-item">
            <a href="../onboarding/" class="nav-link {{isActive activePage 'onboarding'}}" data-nav-id="onboarding">
                <div class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <line x1="19" y1="8" x2="19" y2="14"></line>
                        <line x1="22" y1="11" x2="16" y2="11"></line>
                    </svg>
                </div>
                <span class="nav-text">Onboarding</span>
                <div class="nav-tooltip">Onboarding</div>
            </a>
        </div>

        <div class="nav-item">
            <a href="../billing/" class="nav-link {{isActive activePage 'billing'}}" data-nav-id="billing">
                <div class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                        <line x1="2" y1="10" x2="22" y2="10"></line>
                    </svg>
                </div>
                <span class="nav-text">Billing</span>
                <div class="nav-tooltip">Billing</div>
            </a>
        </div>
    </div>

    <!-- User Section -->
    <div class="user-section">
        <div class="user-info">
            <div class="user-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="user-details">
                <div class="user-name">{{userName}}</div>
                <div class="user-role">{{userRole}}</div>
            </div>
        </div>
    </div>
</nav>